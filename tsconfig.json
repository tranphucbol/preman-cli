{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@preman/core": ["packages/core/src/index.ts"],
      "@preman/core/*": ["packages/core/src/*"],
      "@preman/cli/*": ["packages/cli/src/*"],
      "@preman/desktop/*": ["packages/desktop/src/*"]
    },
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/vite.*.ts", "test/**/*.ts", "vitest.config.ts"],
  // The renderer targets a browser, not Node: it has its own project, with DOM. Tests that exercise
  // it have to compile the same way, so they live in their own program too.
  "exclude": ["packages/desktop/src/renderer/**", "test/renderer/**"]
}
