{
  "name": "preman",
  "version": "0.1.0",
  "description": "Run Postman-format (filesystem) gRPC and HTTP requests from the CLI",
  "type": "module",
  "bin": {
    "preman": "dist/preman.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && chmod +x dist/preman.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@inquirer/prompts": "^7.2.1",
    "ajv": "^8.17.1",
    "atob": "^2.1.2",
    "btoa": "^1.2.1",
    "chai": "^5",
    "cheerio": "1.0.0",
    "crypto-js": "^4.2.0",
    "csv-parse": "^6.1.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "picocolors": "^1.1.1",
    "tv4": "^1.3.0",
    "uuid": "^9.0.1",
    "xml2js": "^0.6.2",
    "yaml": "^2.6.1"
  }
