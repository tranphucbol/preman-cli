{
  "name": "@preman/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for a Postman filesystem workspace",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build --config vite.engine.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts && vite build --config vite.main.config.ts",
    "start": "electron dist/main/main.js",
    "start:inspect": "electron --inspect dist/main/main.js",
    "package": "electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@radix-ui/react-select": "^2.3.7",
    "ajv": "^8.17.1",
    "atob": "^2.1.2",
    "btoa": "^1.2.1",
    "chai": "^5",
    "cheerio": "1.0.0",
    "crypto-js": "^4.2.0",
    "csv-parse": "^6.1.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "tv4": "^1.3.0",
    "uuid": "^9.0.1",
    "xml2js": "^0.6.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  }
