{
  "name": "preman-workspace",
  "private": true,
  "description": "Workspace root for @preman/core, the preman CLI and the desktop app",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/desktop/src/renderer/tsconfig.json && tsc --noEmit -p test/renderer/tsconfig.json",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.json",
    "desktop": "bun run --filter '@preman/desktop' build && bun run --cwd packages/desktop start",
    "desktop:package": "bun run --filter '@preman/desktop' build && bun run --cwd packages/desktop package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@types/chai": "^5",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.10.5",
    "@types/tv4": "^1.2.33",
    "@types/xml2js": "^0.4.14",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "xml2js": "^0.6.2"
  }
}
