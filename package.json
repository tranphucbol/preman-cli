{
  "name": "preman",
  "version": "0.1.0",
  "description": "Run Postman-format (filesystem) gRPC requests from the CLI",
  "type": "module",
  "bin": {
    "preman": "dist/preman.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "vite build && chmod +x dist/preman.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@inquirer/prompts": "^7.2.1",
    "ajv": "^8.17.1",
    "atob": "^2.1.2",
    "btoa": "^1.2.1",
    "chai": "^5",
    "cheerio": "1.0.0",
    "crypto-js": "^4.2.0",
    "csv-parse": "^6.1.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "picocolors": "^1.1.1",
    "tv4": "^1.3.0",
    "uuid": "^9.0.1",
    "xml2js": "^0.6.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/chai": "^5",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.10.5",
    "@types/tv4": "^1.2.33",
    "@types/xml2js": "^0.4.14",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
